# Database
POSTGRES_USER=settled_usr
POSTGRES_PASSWORD=settled_dev
POSTGRES_DB=settled
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database Pool Tuning
DB_MAX_CONNS=10
DB_MIN_IDLE=2
DB_MAX_LIFETIME=3600
DB_MAX_IDLE_TIME=900

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Redis Pool Tuning
REDIS_MAX_CONNS=10
REDIS_MIN_IDLE=2

# Server
PORT=8080